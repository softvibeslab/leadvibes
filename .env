# Copiar a la raíz del repo como archivo `.env` para Docker local:
#   cp docker-local.sample .env
#
# Puertos alternativos (evita choque con 3000/8000/27017 ocupados):
MONGO_HOST_PORT=27027
BACKEND_HOST_PORT=18080
FRONTEND_HOST_PORT=13000

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=rovi_local_dev_change_me
DB_NAME=rovi_crm
JWT_SECRET=local_jwt_secret_must_be_at_least_32_chars_x
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
EMERGENT_LLM_KEY=sk-local-placeholder-not-for-production
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
ENVIRONMENT=development
DEBUG=true

# SendGrid Configuration
SENDGRID_API_KEY=SG_REPLACE_WITH_LOCAL_SENDGRID_API_KEY
SENDGRID_SENDER_EMAIL=noreply@rovirealestate.com
SENDGRID_SENDER_NAME="Rovi Real Estate"
