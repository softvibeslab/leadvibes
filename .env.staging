# Entorno de Staging - Aislado de Producción
# Puertos: Frontend 2403, Backend 1607, MongoDB 2504, Webhook 2906

# ===========================================
# BASE DE DATOS - STAGING (DATOS SEPARADOS)
# ===========================================
DB_NAME_STAGING=rovi_crm_staging
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD_STAGING=staging_admin_secure_password_change_me_12345
MONGO_STAGING_HOST_PORT=2504

# ===========================================
# JWT - STAGING (SECRET DIFERENTE A PROD)
# ===========================================
JWT_SECRET_STAGING=staging_jwt_secret_must_be_at_least_32_chars_and_different_from_production_12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===========================================
# PUERTOS STAGING (DIFERENTES A PRODUCCIÓN)
# ===========================================
FRONTEND_STAGING_HOST_PORT=2403
BACKEND_STAGING_HOST_PORT=1607
WEBHOOK_HOST_PORT=2906

# ===========================================
# ENTORNO
# ===========================================
ENVIRONMENT_STAGING=staging
DEBUG_STAGING=true

# ===========================================
# CORS - STAGING FRONTEND
# ===========================================
CORS_ORIGINS_STAGING=http://localhost:2403,http://127.0.0.1:2403

# ===========================================
# SENDGRID (COMPARTIDO - MISMA API KEY)
# ===========================================
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
SENDGRID_SENDER_EMAIL=noreply@rovirealestate.com
SENDGRID_SENDER_NAME="Rovi Real Estate [STAGING]"

# ===========================================
# WEBHOOKS - INTEGRACIÓN EXTERNA
# ===========================================
WEBHOOK_SECRET=staging_webhook_secret_change_me_in_production_secure_12345

# ===========================================
# AI SERVICES (HEREDADOS DEL .ENV PRINCIPAL)
# ===========================================
EMERGENT_LLM_KEY=sk-local-placeholder-not-for-staging
AIFORDB_API_KEY=